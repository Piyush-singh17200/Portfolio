# -----------------------------------------------------------------------------
# Contact form email delivery
# -----------------------------------------------------------------------------
# Optional: send messages directly through Gmail SMTP.
# 1. Enable 2-Step Verification on your Google account.
# 2. Create a 16-character App Password for "Mail".
# 3. Copy this file to .env.local and fill in the values below.
#
# GMAIL_USER=piyushsingh99899@gmail.com
# GMAIL_APP_PASSWORD=your_16_char_app_password

# Recipient for contact-form messages. Defaults to resumeData.email when omitted.
# CONTACT_RECIPIENT_EMAIL=singhp17200@gmail.com

# Public production URL, used for canonical links and FormSubmit headers.
NEXT_PUBLIC_SITE_URL=https://piyushsingh.tech

# If Gmail SMTP is not configured, the portfolio falls back to FormSubmit.
# FormSubmit sends a one-time activation email on the first submission.
